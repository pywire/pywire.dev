#!/bin/sh
set -e

# ANSI colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info() {
    printf "${BLUE}==>${NC} $1\n"
}

success() {
    printf "${GREEN}==>${NC} $1\n"
}

error() {
    printf "${RED}Error:${NC} $1\n"
    exit 1
}

# Check if uv is installed
if ! command -v uv >/dev/null 2>&1; then
    info "uv is not installed. Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    
    # Try to source the cargo env if it exists (standard rust/uv install location)
    if [ -f "$HOME/.cargo/env" ]; then
        . "$HOME/.cargo/env"
    elif [ -f "$HOME/.local/bin/env" ]; then
        . "$HOME/.local/bin/env"
    else
        # Fallback: add common install paths to PATH for this session
        export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
    fi
    
    if ! command -v uv >/dev/null 2>&1; then
        error "Failed to install uv or add it to PATH. Please install uv manually: https://docs.astral.sh/uv/getting-started/installation/"
    fi
    success "uv installed successfully"
else
    info "uv is already installed"
fi

# Run create-pywire-app
info "Running create-pywire-app..."
# `curl | sh` feeds this script on stdin, so reattach the terminal for
# create-pywire-app's prompts, but only if there is one (CI, containers and
# agents have no /dev/tty).
if [ -t 0 ]; then
    exec uvx create-pywire-app "$@"
elif (exec < /dev/tty) 2>/dev/null; then
    exec uvx create-pywire-app "$@" < /dev/tty
else
    exec uvx create-pywire-app "$@"
fi
