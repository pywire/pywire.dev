---
import Logo from './Logo.astro'

/**
 * Footer — minimal, monoface eyebrow column headers, lockup at the left.
 * Apache 2.0-licensed badge + copyright line in the bottom row.
 */
const currentYear = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-lockup">
      <Logo loading="lazy" />
      <p class="footer-tagline">HTML-over-the-wire for Python. Apache 2.0 licensed. Built in the open.</p>
    </div>
    <div class="footer-cols">
      <section>
        <p class="footer-heading">Learn</p>
        <ul>
          <li><a href="/docs/guides/quickstart/">Quickstart</a></li>
          <li><a href="/docs/tutorial/">Tutorial</a></li>
          <li><a href="/docs/reference/api/">API Reference</a></li>
        </ul>
      </section>
      <section>
        <p class="footer-heading">Community</p>
        <ul>
          <li><a href="https://github.com/pywire/pywire">GitHub</a></li>
          <li><a href="https://github.com/pywire/pywire/discussions">Discussions</a></li>
          <li><a href="#">Discord</a></li>
        </ul>
      </section>
      <section>
        <p class="footer-heading">Project</p>
        <ul>
          <li><a href="/docs/changelog/">Changelog</a></li>
          <li><a href="https://github.com/pywire/pywire/blob/main/LICENSE">License (Apache 2.0)</a></li>
          <li><a href="#">Security</a></li>
        </ul>
      </section>
    </div>
  </div>
  <div class="container footer-baseline">
    <p>&copy; {currentYear} pywire</p>
    <p>Made for the Python community.</p>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    margin-top: var(--space-3xl);
    padding: var(--space-2xl) 0 var(--space-xl);
    background: var(--surface-2-color);
    border-top: 1px solid var(--border-color-subtle);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);

    @media (min-width: 700px) {
      grid-template-columns: 1fr 2fr;
    }
  }

  .footer-lockup {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer-tagline {
    margin: 0;
    max-width: 18rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-decoration-color);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);

    @media (max-width: 500px) {
      grid-template-columns: 1fr;
    }

    section {
      ul {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      a {
        color: var(--foreground-color);
        text-decoration: none;
        font-size: 0.9rem;

        &:hover {
          color: var(--accent-color);
        }
      }
    }
  }

  .footer-heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-decoration-color);
    font-weight: 500;
  }

  .footer-baseline {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--border-color-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-decoration-color);

    @media (min-width: 700px) {
      flex-direction: row;
      justify-content: space-between;
    }

    p {
      margin: 0;
    }
  }
</style>
