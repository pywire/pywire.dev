---
import { Heading } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Feature Component
 *
 * @description A component that displays a feature with an icon, title, and description
 */
interface Props {
  /**
   * The icon to display
   */
  icon: string
  /**
   * The title to display
   */
  title: string
}

const { icon = 'mdi:rocket', title = 'Title' }: Props = Astro.props
---

<div class="hud-card flex flex-col gap-4">
  <Icon aria-hidden="true" name={icon} />
  <div class="content">
    <Heading level="h3" size="h6" class="mb-2">{title}</Heading>
    <p>
      <slot>Lorem ipsum dolor sit amet consectetur adipisicing elit. Hic, corporis.</slot>
    </p>
  </div>
</div>

<style lang="scss">
  .hud-card {
    position: relative;
    padding: var(--space-l);
    background: var(--surface-color);
    border: 1px solid var(--border-color-subtle);
    border-left: 4px solid var(--color-wire-glow);
    border-radius: var(--radius-small);
    transition: all var(--animation-speed-fast) var(--cubic-bezier);
    backdrop-filter: blur(8px);

    &:hover {
      transform: translateY(-4px);
      border-color: var(--color-wire-glow);
      box-shadow: 0 10px 30px -10px rgba(0, 240, 255, 0.2);
      
      :global([data-icon]) {
        filter: drop-shadow(0 0 8px var(--color-wire-glow));
      }
    }

    :global([data-icon]) {
      inline-size: 3rem;
      block-size: auto;
      color: var(--color-wire-glow);
      transition: all var(--animation-speed-fast) var(--cubic-bezier);
    }

    .content {
      p {
        color: var(--foreground-color);
        opacity: 0.8;
        font-size: 0.95rem;
        line-height: 1.6;
      }
    }
  }
</style>
