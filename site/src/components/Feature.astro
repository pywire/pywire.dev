---
import { Heading } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Feature card — surface bg, border, accent icon-chip, title, body.
 * Optional monoface highlight chip — used for code-token examples like
 * `count = wire(0)` so the card carries a piece of the framework's
 * actual syntax. Hover shifts border to accent; no lift, no shadow.
 */
interface Props {
  icon: string
  title: string
  highlight?: string | string[]
}

const { icon = 'lucide:zap', title = 'Title', highlight }: Props = Astro.props
const highlights = Array.isArray(highlight) ? highlight : highlight ? [highlight] : []
---

<article class="feature-card">
  <span class="feature-icon-chip" aria-hidden="true">
    <Icon name={icon} />
  </span>
  <Heading level="h3" size="h6" class="feature-title">{title}</Heading>
  <p class="feature-body">
    <slot>Lorem ipsum dolor sit amet consectetur adipisicing elit. Hic, corporis.</slot>
  </p>
  {
    highlights.length > 0 && (
      <div class="feature-highlights">
        {highlights.map((h) => (
          <code class="feature-highlight">{h}</code>
        ))}
      </div>
    )
  }
</article>

<style lang="scss">
  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.6rem 1.5rem;
    background: var(--surface-color);
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-l);
    transition: border-color var(--animation-speed-fast) var(--cubic-bezier);

    &:hover {
      border-color: var(--accent-color);
    }
  }

  .feature-icon-chip {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-bg-color);
    color: var(--accent-color);

    :global([data-icon]) {
      width: 1.125rem;
      height: 1.125rem;
    }
  }

  :global(.feature-title) {
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .feature-body {
    margin: 0;
    color: var(--text-decoration-color);
    font-size: 0.95rem;
    line-height: 1.55;
    text-wrap: pretty;

    :global(code) {
      font-family: var(--font-mono);
      font-size: 0.85em;
      color: var(--accent-color);
      background: var(--accent-bg-color);
      padding: 0.05em 0.35em;
      border-radius: var(--radius-s);
    }
  }

  .feature-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .feature-highlight {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-color);
    background: var(--accent-bg-color);
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius-s);
  }
</style>
