---
import { Link } from 'accessible-astro-components'
import PywireMark from '../assets/img/pywire-mark.svg'

/**
 * Logo Component — chip-framed pywire mark + monoface wordmark.
 *
 * The mark uses currentColor so it inherits the accent color (cyan-65 on Lab,
 * cyan-90 on Void). The chip is a 32px rounded-square frame in the accent's
 * tint with a 1.5px accent-edge border — on Void it picks up an inset+outer
 * cyan halo, on Lab it stays quiet.
 */
---

<Link href="/" class="logo-lockup" aria-label="pywire — home">
  <span class="logo-chip" aria-hidden="true">
    <PywireMark class="logo-mark" preserveAspectRatio="xMidYMid meet" width="100%" height="100%" />
  </span>
  <span class="logo-wordmark">pywire</span>
</Link>

<style lang="scss">
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    transition: color var(--animation-speed-fast) var(--cubic-bezier);
    color: var(--accent-color);
    font-weight: 600;
    font-size: 1.125rem;
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  // 32px rounded-square chip — accent-tinted background, 1.5px accent-edge.
  // On Void the chip glows; on Lab it stays a quiet brand frame.
  .logo-chip {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    border: 1.5px solid color-mix(in oklch, var(--accent-color) 30%, transparent);
    border-radius: 7px;
    background: light-dark(
      color-mix(in oklch, var(--accent-color) 8%, transparent),
      color-mix(in oklch, var(--accent-color) 10%, transparent)
    );
    padding: 4px;
    width: 32px;
    height: 32px;
  }

  :root.darkmode .logo-chip {
    box-shadow:
      0 0 8px color-mix(in oklch, var(--accent-color) 30%, transparent),
      inset 0 0 5px color-mix(in oklch, var(--accent-color) 18%, transparent);
  }

  .logo-mark {
    display: block;
    width: 100%;
    height: 100%;
  }

  :root.darkmode .logo-mark {
    filter: drop-shadow(0 0 3px color-mix(in oklch, var(--accent-color) 50%, transparent));
  }

  .logo-wordmark {
    color: var(--accent-color);
    text-shadow: 0 0 8px color-mix(in oklch, var(--accent-color) 22%, transparent);
  }

  .logo-lockup:hover,
  .logo-lockup:focus-visible {
    color: var(--link-hover-color);
  }
</style>
