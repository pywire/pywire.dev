---
import Navigation from '../components/Navigation.astro'
import { DarkMode, Link, SkipLink } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Header Component
 *
 * @description A component that displays the header of the website
 */
---

<header>
  <SkipLink />
  <Navigation>
    <li class="menu-item">
      <Link href="/docs/guides/quickstart/">Docs</Link>
    </li>
    <li class="menu-item">
      <Link href="/docs/tutorial/">Tutorial</Link>
    </li>
    <li class="menu-item">
      <Link href="/docs/reference/api/">API</Link>
    </li>
    <li class="menu-item">
      <Link href="/roadmap/">Roadmap</Link>
    </li>
    <li class="menu-item type-icon" slot="secondary">
      <Link isExternal hideIcon href="https://github.com/pywire/pywire" title="GitHub">
        <Icon aria-hidden="true" name="lucide:github" />
        <span class="sr-only">GitHub</span>
      </Link>
    </li>
    <li class="menu-item type-icon" slot="secondary">
      <a href="#" title="Discord">
        <Icon aria-hidden="true" name="simple-icons:discord" />
        <span class="sr-only">Discord</span>
      </a>
    </li>
    <li class="menu-item type-icon" slot="secondary">
      <Link isExternal hideIcon href="#" title="Discussions">
        <Icon aria-hidden="true" name="lucide:message-square" />
        <span class="sr-only">Discussions</span>
      </Link>
    </li>
    <li class="menu-item type-icon" slot="secondary">
      <DarkMode>
        <Icon aria-hidden="true" name="lucide:moon" slot="light" />
        <Icon aria-hidden="true" name="lucide:sun" slot="dark" />
      </DarkMode>
    </li>
  </Navigation>
</header>

<script>
  // Once the header has scrolled away, bring it back when the mouse nears the
  // top of the screen (or focus lands in it), and tuck it away again when the
  // mouse moves on.
  const NEAR = 48
  let shown = false
  const header = () => document.querySelector('body > header') as HTMLElement | null
  const place = () => {
    const el = header()
    if (!el) return
    el.style.top = `${-el.offsetHeight}px`
    el.style.translate = shown ? `0 ${Math.min(scrollY, el.offsetHeight)}px` : ''
    el.toggleAttribute('data-revealed', shown && scrollY > 0)
  }
  const show = (on: boolean) => {
    const el = header()
    if (!el || on === shown) return
    if (!on && (el.matches(':focus-within') || el.querySelector('[aria-expanded="true"]'))) return
    shown = on
    place()
  }
  addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return
    const el = header()
    if (!el) return
    if (e.clientY < NEAR) show(true)
    else if (e.clientY > el.offsetHeight + NEAR) show(false)
  })
  addEventListener('scroll', place, { passive: true })
  addEventListener('focusin', (e) => {
    if (header()?.contains(e.target as Node)) show(true)
  })
  document.addEventListener('astro:page-load', () => {
    shown = false
    place()
  })
</script>

<style lang="scss" is:global>
  body > header {
    // Sticks just above the screen once scrolled away, so it can slide back in.
    position: sticky;
    top: -57px;
    z-index: 100;
    transition: translate 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);

    &[data-revealed] #main-navigation {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  header {
    .type-icon {
      display: block;
      margin-inline: 0;

      svg {
        inline-size: 18px;
        block-size: 18px;
      }
    }

    /* Compact theme toggle — 28px square chip, accent on hover. Perfectly
       centered icon via grid place-items. */
    .darkmode-toggle {
      display: grid;
      place-items: center;
      transition: border-color var(--animation-speed-fast) var(--cubic-bezier);
      cursor: pointer;
      margin: 0;
      outline: none;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background: transparent;
      padding: 0;
      width: 28px;
      height: 28px;
      color: var(--foreground-color);
      line-height: 0;

      &:hover,
      &:focus-visible {
        border-color: var(--accent-color);
        color: var(--accent-color);
      }

      &:focus-visible {
        box-shadow: 0 0 0 2px color-mix(in oklch, var(--accent-color) 35%, transparent);
      }

      .icon-light,
      .icon-dark {
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 100%;
      }

      svg,
      .icon svg {
        display: block;
        width: 14px !important;
        height: 14px !important;
      }
    }
  }
</style>
