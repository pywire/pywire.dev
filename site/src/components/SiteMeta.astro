---
/**
 * SiteMeta Component
 *
 * @description Component to handle site metadata and essential head elements
 */
interface Props {
  /**
   * The page-specific title segment. Omit on the home page so the brand
   * tagline is used instead of "Home | PyWire".
   */
  title?: string
  description: string
  url: string
  image: string
  author?: string
}

const { title, description, url, image, author = 'PyWire' } = Astro.props

const siteName = 'PyWire'
const tagline = 'The Live Conduit for Python'
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} — ${tagline}`
---

<!-- general meta -->
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />

<!-- open graph -->
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<meta property="og:image" content={`${Astro.site}${image}`} />

<!-- page title -->
<title>{fullTitle}</title>
